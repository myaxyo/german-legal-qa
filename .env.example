# German Legal QA – Environment Configuration
# Copy to .env and adjust values as needed

# Device: mps (Apple Silicon), cuda (NVIDIA), cpu
GLQA_DEVICE=mps

# Logging
GLQA_LOG_LEVEL=INFO

# Data settings
GLQA_DATA_MAX_DECISIONS=100000

# Embedding
GLQA_EMB_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GLQA_EMB_DEVICE=mps
GLQA_EMB_BATCH_SIZE=64

# RAG
GLQA_RAG_TOP_K=5
GLQA_RAG_GENERATOR_MODEL=unsloth/Llama-3.2-3B-Instruct
GLQA_RAG_MAX_NEW_TOKENS=1024
GLQA_RAG_TEMPERATURE=0.3

# Training
GLQA_TRAIN_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
GLQA_TRAIN_QUANTIZATION=4bit
GLQA_TRAIN_EPOCHS=3
GLQA_TRAIN_LEARNING_RATE=0.0002
GLQA_TRAIN_LORA_R=16
GLQA_TRAIN_LORA_ALPHA=32

# Evaluation
GLQA_EVAL_NUM_SAMPLES=500

# HuggingFace Hub (optional – for pushing models)
# HF_TOKEN=hf_xxxxxxxxxxxxx
# GLQA_TRAIN_HUB_MODEL_ID=your-username/german-legal-qa-3b
